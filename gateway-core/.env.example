PORT=3000
CHECKOUT_BASE_URL=http://localhost:3000/pay
ADMIN_TOKEN=change-me-to-a-long-random-string
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=
PUBLIC_BASE_URL=http://localhost:3000
# Development only: allow webhooks to http://localhost. Keep unset/false in production.
ALLOW_PRIVATE_WEBHOOK_TARGETS=false
# NODE_ENV=production enables Secure cookies. PUBLIC_BASE_URL must be the exact origin the dashboard is served from (CSRF origin check).
APP_NAME=Gateway
PLATFORM_MERCHANT_ID=
BILLING_MODE=test
PLATFORM_LEGAL_NAME=Your Company Pvt Ltd
PLATFORM_GSTIN=
PLATFORM_ADDRESS=
PLATFORM_STATE_CODE=10
TRIAL_DAYS=14
